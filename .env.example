# =============================================================================
#  Social Video API — variables de entorno
# =============================================================================
#  Copia este fichero a `.env` y rellena los valores:
#      cp .env.example .env
#
#  El fichero `.env` NUNCA se sube al repositorio (está en .gitignore).
# =============================================================================


# -----------------------------------------------------------------------------
# 1. APLICACIÓN
# -----------------------------------------------------------------------------
APP_NAME="Social Video API"
ENVIRONMENT=development          # development | staging | production
DEBUG=false
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                   # true en producción (logs estructurados)
API_PREFIX=/v1

# URL pública de ESTA API. Es imprescindible para:
#   * los callbacks OAuth (redirect_uri),
#   * que Instagram/TikTok puedan DESCARGAR el video (`video_url`).
#
# En GitHub Codespaces:  https://<nombre-codespace>-8000.app.github.dev
#   (el puerto 8000 debe estar en visibilidad "Public")
# En local:              http://localhost:8000  (Instagram NO podrá descargar)
# Con Cloudflare Tunnel: https://<subdominio>.trycloudflare.com
PUBLIC_BASE_URL=http://localhost:8000


# -----------------------------------------------------------------------------
# 2. SEGURIDAD  (¡genera valores propios, no uses los de ejemplo!)
# -----------------------------------------------------------------------------
# Clave Fernet para CIFRAR los tokens OAuth en la base de datos.
#   Generar:  python -m app.security.crypto --generate-key
ENCRYPTION_KEY=

# Clave HMAC para firmar las URLs temporales de descarga de media y validar
# los webhooks de Meta (úsala como `verify_token` en el panel de Meta).
#   Generar:  python -m app.security.crypto --generate-secret
SIGNING_SECRET=

# API keys de ADMINISTRACIÓN (crear clientes y rotar API keys). Coma-separadas.
# Si queda vacío, /v1/admin/* devuelve 503 (deshabilitado).
#   Generar:  python -m app.security.crypto --generate-api-key
ADMIN_API_KEYS=

# API keys de CLIENTE precargadas al arrancar (cómodo en desarrollo).
# Es la key que usará Macaly:  Authorization: Bearer <valor>
# En producción deja esto vacío y emítelas con POST /v1/admin/clients.
BOOTSTRAP_API_KEYS=

# CORS: dominios permitidos, coma-separados. En producción pon el de Macaly.
#   Ejemplo: CORS_ALLOW_ORIGINS=https://tu-app.macaly.app,https://tudominio.com
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false


# -----------------------------------------------------------------------------
# 3. BASE DE DATOS
# -----------------------------------------------------------------------------
# Desarrollo sin Docker (cero dependencias):
#   DATABASE_URL=sqlite:///./data/social_video_api.db
# Desarrollo/producción con PostgreSQL (docker compose ya lo levanta):
#   DATABASE_URL=postgresql+psycopg://svapi:svapi@localhost:5432/social_video_api
DATABASE_URL=sqlite:///./data/social_video_api.db
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5


# -----------------------------------------------------------------------------
# 4. REDIS / CELERY  (publicaciones en segundo plano y programadas)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=              # vacío = usa REDIS_URL
CELERY_RESULT_BACKEND=          # vacío = usa REDIS_URL

# true  → las publicaciones se ejecutan EN EL PROPIO PROCESO de la API
#         (útil para probar sin Redis; bloquea la request hasta terminar)
# false → se encolan en Celery (recomendado; requiere Redis + worker)
CELERY_TASK_ALWAYS_EAGER=false

# Barredor de publicaciones programadas dentro del proceso de la API.
# true  → cómodo en Codespaces: un solo comando lo hace todo.
# false → en producción usa `celery -A app.workers.celery_app beat`.
SCHEDULER_IN_PROCESS=true
SCHEDULER_INTERVAL_SECONDS=30


# -----------------------------------------------------------------------------
# 5. ALMACENAMIENTO DE VIDEOS
# -----------------------------------------------------------------------------
STORAGE_BACKEND=local            # local | s3
LOCAL_STORAGE_PATH=./data/media
MEDIA_RETENTION_HOURS=24         # los videos se borran pasadas estas horas
MEDIA_URL_TTL_MINUTES=120        # validez de la URL firmada de descarga

# --- Sólo si STORAGE_BACKEND=s3 (Amazon S3 / Cloudflare R2 / MinIO) ---
# Cloudflare R2:  https://dash.cloudflare.com → R2 → Manage API Tokens
# Amazon S3:      https://console.aws.amazon.com/iam → usuario con acceso S3
S3_BUCKET=
S3_REGION=auto                   # "auto" en R2; p. ej. "eu-west-1" en AWS
S3_ENDPOINT_URL=                 # R2: https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=              # dominio público del bucket, si lo tiene
S3_ADDRESSING_STYLE=auto         # auto | path | virtual


# -----------------------------------------------------------------------------
# 6. VALIDACIÓN DE VIDEO
# -----------------------------------------------------------------------------
MAX_VIDEO_SIZE_MB=512
ALLOWED_VIDEO_MIME_TYPES=video/mp4,video/quicktime,video/webm
ALLOWED_VIDEO_EXTENSIONS=.mp4,.mov,.webm


# -----------------------------------------------------------------------------
# 7. RATE LIMITING Y REINTENTOS
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120          # peticiones por ventana y por API key
RATE_LIMIT_WINDOW_SECONDS=60

MAX_PUBLISH_ATTEMPTS=5
RETRY_BASE_DELAY_SECONDS=30
RETRY_MAX_DELAY_SECONDS=3600

PROCESSING_TIMEOUT_SECONDS=900   # espera máxima a que la plataforma procese
PROCESSING_POLL_INTERVAL_SECONDS=20   # no bajar de 20 s: evita polling agresivo
HTTP_TIMEOUT_SECONDS=60
UPLOAD_TIMEOUT_SECONDS=600


# =============================================================================
# 8. INSTAGRAM  (Meta / Instagram Content Publishing API)
# =============================================================================
# QUÉ NECESITAS:
#   1. Una cuenta de Instagram **Professional** (Business o Creator).
#      Instagram → Configuración → Tipo de cuenta → Cambiar a profesional.
#      Las cuentas personales NO pueden publicar por API.
#   2. Una App de Meta:  https://developers.facebook.com/apps  → "Crear app"
#   3. Añadir el producto **Instagram** a la app.
#   4. Copiar el "Instagram App ID" y el "Instagram App Secret":
#      App → Productos → Instagram → Configuración de la API
#   5. Registrar la Redirect URI EXACTA (abajo) en:
#      App → Instagram → Configuración de la API → OAuth redirect URIs
#   6. Permisos (scopes) que la app debe solicitar/tener aprobados:
#        instagram_business_basic, instagram_business_content_publish
#      En modo Desarrollo funcionan con los usuarios de prueba/roles de la app.
#      Para publicar en cuentas de terceros hace falta App Review de Meta.
#
# LÍMITE OFICIAL: 100 publicaciones por API cada 24 h y por cuenta.
#   Consultable en:  GET /v1/accounts/{id}/publishing-limit
#
# ENDPOINTS QUE USA ESTA API (host y versión configurables abajo):
#   POST /{ig-user-id}/media          → crear contenedor
#   POST rupload.facebook.com/...     → subida resumible del fichero
#   GET  /{container-id}?fields=status_code
#   POST /{ig-user-id}/media_publish
#   GET  /{ig-user-id}/content_publishing_limit
# -----------------------------------------------------------------------------
INSTAGRAM_LOGIN_MODE=instagram   # instagram (Business Login) | facebook (Facebook Login)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Debe coincidir EXACTAMENTE con la registrada en el panel de Meta:
INSTAGRAM_REDIRECT_URI=http://localhost:8000/v1/oauth/instagram/callback
INSTAGRAM_GRAPH_VERSION=v25.0
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_content_publish
# Sólo si INSTAGRAM_LOGIN_MODE=facebook (requiere Página de Facebook vinculada):
INSTAGRAM_FACEBOOK_SCOPES=instagram_basic,instagram_content_publish,pages_show_list,pages_read_engagement


# =============================================================================
# 9. TIKTOK  (Content Posting API v2)
# =============================================================================
# QUÉ NECESITAS:
#   1. Cuenta de developer:  https://developers.tiktok.com  → "Manage apps"
#   2. Crear una app y añadir los productos:
#        - **Login Kit**            (OAuth)
#        - **Content Posting API**  (publicación)
#   3. Copiar "Client key" y "Client secret" de la app.
#   4. Registrar la Redirect URI EXACTA (abajo) en Login Kit → Redirect URI.
#   5. Solicitar los scopes:
#        user.info.basic   → identidad de la cuenta
#        video.publish     → Direct Post (publica directamente)
#        video.upload      → deja el video en los borradores de la app TikTok
#   6. Para `PULL_FROM_URL` hay que VERIFICAR LA PROPIEDAD DEL DOMINIO
#      desde el que se sirve el video (panel → "URL prefix verification").
#
# ⚠️ AUDITORÍA OBLIGATORIA DE TIKTOK:
#   Mientras la app NO haya pasado el *audit* de TikTok, TODO el contenido
#   publicado queda restringido a visibilidad PRIVADA (SELF_ONLY). No hay forma
#   de saltárselo. Pon TIKTOK_AUDIT_PASSED=true sólo cuando TikTok te lo apruebe;
#   entonces la API pasará a pedir PUBLIC_TO_EVERYONE por defecto.
#   Solicitud de audit: panel de la app → Content Posting API → "Submit for review".
#
# LÍMITE OFICIAL: 6 peticiones/minuto por access token en los endpoints de init.
# -----------------------------------------------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8000/v1/oauth/tiktok/callback
TIKTOK_SCOPES=user.info.basic,video.publish,video.upload
TIKTOK_POST_MODE=DIRECT_POST      # DIRECT_POST (publica) | INBOX (borradores)
TIKTOK_AUDIT_PASSED=false         # true sólo cuando TikTok apruebe el audit


# =============================================================================
# 10. YOUTUBE  (YouTube Data API v3)
# =============================================================================
# QUÉ NECESITAS:
#   1. Un proyecto en Google Cloud:  https://console.cloud.google.com
#   2. Habilitar la API:  APIs y servicios → Biblioteca → "YouTube Data API v3"
#   3. Pantalla de consentimiento OAuth:  APIs y servicios → Pantalla de
#      consentimiento OAuth. Añade tu cuenta como "Usuario de prueba" mientras
#      la app esté en modo Testing.
#   4. Credenciales:  APIs y servicios → Credenciales → Crear credenciales →
#      "ID de cliente de OAuth" → tipo **Aplicación web**.
#      Copia "Client ID" y "Client secret".
#   5. Registrar la Redirect URI EXACTA (abajo) en "URIs de redireccionamiento
#      autorizados" de esa credencial.
#   6. Scopes usados:
#        https://www.googleapis.com/auth/youtube.upload
#        https://www.googleapis.com/auth/youtube.readonly
#
# ⚠️ CUOTA Y AUDITORÍA DE GOOGLE:
#   * `videos.insert` cuesta 1600 unidades y la cuota diaria por defecto son
#     10 000 unidades → unas 6 subidas al día. Se amplía solicitándolo a Google.
#   * Los proyectos SIN verificar creados después del 28/07/2020 sólo pueden
#     subir videos en modo **private** hasta pasar la auditoría de Google.
#   * Shorts: no hay endpoint especial. Se sube con el flujo normal y YouTube lo
#     clasifica como Short si es vertical y dura <= 3 minutos.
# -----------------------------------------------------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/v1/oauth/youtube/callback
YOUTUBE_DEFAULT_PRIVACY=private   # private | unlisted | public
YOUTUBE_DEFAULT_CATEGORY_ID=22    # 22 = People & Blogs
