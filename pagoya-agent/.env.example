SECRET_KEY=cambia-esto-por-una-cadena-larga-aleatoria
OWNER_EMAIL=mercadomarcelo5559@gmail.com
OWNER_NAME=Marcelo
OWNER_WHATSAPP=+52XXXXXXXXXX        # tu celular personal (pruebas y avisos urgentes)
ENABLE_SCHEDULER=true
# MODO PRUEBA: true = TODO mensaje de WhatsApp/correo a prospectos se redirige a OWNER_WHATSAPP / OWNER_EMAIL
